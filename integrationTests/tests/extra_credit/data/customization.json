/*
Test case: extra credit gradeables.

  * The "homework" bucket carries 100% of the grade and contains three
    gradeables.  hw03_extra_credit has "max": 0, which makes it extra credit
    WITHIN the bucket: it is excluded from the bucket denominator but its
    "scale_max" points still contribute to the numerator.

  * The "participation" bucket is a PURE extra credit bucket: every gradeable
    in it has "max": 0, so the bucket contributes on top of the 100% rather
    than taking a share of it.  Its "percent" (0.05) is the size of the bonus.

Expected overall for a student who earns everything: 105 + 5 == 110.
*/
{
  "display_benchmark": [
    "average",
    "stddev",
    "perfect"
  ],
  "section": {
    "1": "ta_alice",
    "2": "ta_bob"
  },
  "messages": [
    "<b>Extra Credit Test Course</b>"
  ],
  "display": [
    "grade_summary",
    "grade_details"
  ],
  "benchmark_percent": {
    "lowest_a-": 0.9,
    "lowest_b-": 0.8,
    "lowest_c-": 0.7,
    "lowest_d": 0.6
  },
  "gradeables": [
    {
      "type": "homework",
      "count": 3,
      "percent": 1.0,
      "ids": [
        {
          "id": "hw01",
          "max": 100.0
        },
        {
          "id": "hw02",
          "max": 100.0
        },
        {
          "id": "hw03_extra_credit",
          "max": 0.0,
          "scale_max": 10.0
        }
      ]
    },
    {
      "type": "participation",
      "count": 2,
      "percent": 0.05,
      "ids": [
        {
          "id": "participation01",
          "max": 0.0,
          "scale_max": 5.0
        },
        {
          "id": "participation02",
          "max": 0.0,
          "scale_max": 5.0
        }
      ]
    }
  ]
}
